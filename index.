<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>if(endT&gt;90 &amp;&amp; (frame&gt;&gt;4)%2) txt(TOUCH?'START: JOGAR DE NOVO':'ENTER: JOGAR DE NOVO', 128, 230, '#fff', 8, 'center');</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>parts.forEach(q=&gt;{</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">    </span>if(q.life&lt;8&amp;&amp;(frame&amp;1))return;</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">    </span>ctx.fillStyle=q.col; ctx.fillRect(Math.round(q.x),Math.round(q.y),2,2);</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>});</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>heartsUp.forEach(h=&gt; ctx.drawImage(HEART, Math.round(h.x), Math.round(h.y)));</span></p>
<p class="p1"><span class="s1">}</span></p>
<p class="p1"><span class="s1">function draw(){</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>switch(state){</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">    </span>case 'title':<span class="Apple-converted-space">  </span>drawTitle(); break;</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">    </span>case 'card': <span class="Apple-converted-space">  </span>drawCard(); break;</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">    </span>case 'letter': drawLetter(); break;</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">    </span>case 'end':<span class="Apple-converted-space">    </span>drawEnd(); break;</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">    </span>default: <span class="Apple-converted-space">      </span>drawWorld(); drawDialog();</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>}</span></p>
<p class="p1"><span class="s1">}</span></p>
<p class="p2"><span class="s1"></span><br></p>
<p class="p1"><span class="s1">/* ---------------- LOOP + AJUSTE DE TELA ---------------- */</span></p>
<p class="p1"><span class="s1">function loop(){ requestAnimationFrame(loop); t+=1/60; frame++; update(); draw(); }</span></p>
<p class="p1"><span class="s1">function fit(){</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>const padH = TOUCH ? 175 : 125;</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>let s = Math.min((innerWidth-20)/W, (innerHeight-padH)/H);</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>if(s&gt;=2) s=Math.floor(s);</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>s=Math.max(0.55,s);</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>cvs.style.width=Math.round(W*s)+'px';</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>cvs.style.height=Math.round(H*s)+'px';</span></p>
<p class="p1"><span class="s1">}</span></p>
<p class="p1"><span class="s1">addEventListener('resize', fit);</span></p>
<p class="p1"><span class="s1">addEventListener('orientationchange', fit);</span></p>
<p class="p1"><span class="s1">fit();</span></p>
<p class="p2"><span class="s1"></span><br></p>
<p class="p1"><span class="s1">let started=false;</span></p>
<p class="p1"><span class="s1">function start(){ if(started) return; started=true; state='title'; requestAnimationFrame(loop); }</span></p>
<p class="p1"><span class="s1">if(document.fonts &amp;&amp; document.fonts.load){</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>Promise.all([document.fonts.load('8px "Press Start 2P"'),document.fonts.load('16px "Press Start 2P"')]).then(start,start);</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">  </span>setTimeout(start,1500);</span></p>
<p class="p1"><span class="s1">}else{ start(); }</span></p>
<p class="p1"><span class="s1">&lt;/script&gt;</span></p>
<p class="p1"><span class="s1">&lt;/body&gt;</span></p>
